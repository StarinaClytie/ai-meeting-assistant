# 转写提供方：正式部署使用 aliyun，本机模型备用时使用 local
TRANSCRIPTION_PROVIDER=aliyun
HOST=127.0.0.1
PORT=5173

# 阿里云百炼 / Model Studio（密钥不要提交到 GitHub）
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=beijing
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_ASR_MODEL=fun-asr
DASHSCOPE_LANGUAGE_HINTS=zh,en
# 已在阿里云创建固定热词表时填写；没有可以暂时留空
DASHSCOPE_VOCABULARY_ID=
# 已知参会人数时可填写 2-100；不确定可以留空
DASHSCOPE_SPEAKER_COUNT=

# 阿里云 OSS 私有 Bucket
# OSS 可以与百炼不同地域；当前部署使用新加坡 OSS + 北京百炼
# 常用地域：oss-ap-southeast-1（新加坡）/ oss-cn-hongkong（香港）
OSS_REGION=oss-ap-southeast-1
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_OBJECT_PREFIX=meeting-audio
OSS_SIGNED_URL_EXPIRES_SECONDS=21600

# 智谱会议总结
SUMMARY_PROVIDER=bigmodel
BIGMODEL_API_KEY=
BIGMODEL_MODEL=glm-4-flash
SUMMARY_MAX_TOKENS=4000
SUMMARY_TIMEOUT_MS=120000

# 本机 FunASR 备用配置
PYTHON_BIN=python3
FUNASR_DEVICE=cpu
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_MAX_SECONDS=180
